# Copia este archivo como .env y coloca tus claves

# Obligatorias
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# Opcional: modelo a usar (por defecto gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Opcional: historial persistente en Supabase. Sin esta variable el historial vive en RAM.
# En Supabase: botón "Connect" > "Connection String" > "Session pooler" (compatible con IPv4).
# Sustituye [YOUR-PASSWORD] por la contraseña de tu base de datos.
# SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Opcional: tracing en LangSmith para depurar
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=research-assistant
